# Configuração local do Docker Compose. Nunca use estes valores em produção.
JWT_SECRET=local-only-change-this-jwt-secret-before-using-it-elsewhere
APP_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Cloudinary (por padrão no Docker Compose aponta para o container local cloudinary-mock)
CLOUDINARY_CLOUD_NAME=pe-na-areia-local
CLOUDINARY_API_KEY=local-key-123456
CLOUDINARY_API_SECRET=local-secret-123456
CLOUDINARY_UPLOAD_PREFIX=http://cloudinary-mock:8099

# Gateway Pix e Webhook (opcional — possui fallback EMV BR Code determinístico local)
PIX_WEBHOOK_TOKEN=pe-na-areia-pix-webhook-secret
PIX_WEBHOOK_SECRET=pe-na-areia-pix-webhook-secret
PIX_GATEWAY_URL=
PIX_GATEWAY_TOKEN=
